# Keep Unix line endings on scripts no matter how git is set up on the
# machine that checks them out - a CRLF shebang breaks them on macOS/Linux.
* text=auto
*.py      text eol=lf
*.sh      text eol=lf
*.command text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.png     binary
*.toml text eol=lf
MANIFEST.in text eol=lf
